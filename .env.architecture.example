# Copy to .env.architecture.local. Replace the sample storage values locally.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://object-store:9000
S3_BUCKET=wardrobe
S3_ACCESS_KEY=replace-with-unique-local-access-key
S3_SECRET_KEY=replace-with-unique-local-secret-key
S3_REGION=us-east-1
S3_SECURE=false
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
